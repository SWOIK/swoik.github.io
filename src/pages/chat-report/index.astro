<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/fonts/chat-report/fonts.css" />
    <link
      rel="preload"
      href="/fonts/chat-report/Prompt-800-thai.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip" href="#main">ข้ามไปเนื้อหาหลัก</a>

    <div class="banner" role="note">
      <b>ต้นแบบ (Prototype)</b> · ทดสอบแนวคิดเท่านั้น ยังไม่เปิดให้บริการ ไม่มีการอัปโหลดแชทและไม่เก็บข้อมูลใด
      ๆ ตัวอย่างทั้งหมดเป็นข้อมูลสมมติ
    </div>

    <header class="top">
      <a class="brand" href="#top" aria-label="ป้าเม้าท์ กลับขึ้นบนสุด">
        <span class="brand-dot" aria-hidden="true">🍵</span>ป้าเม้าท์
      </a>
      <nav aria-label="เมนูหลัก">
        <a href="#how">วิธีใช้</a>
        <a href="#includes">ในรายงาน</a>
        <a href="#privacy">ความเป็นส่วนตัว</a>
        <a href="#pricing">ราคา</a>
        <a href="#faq">คำถาม</a>
        <a class="btn btn-sm" href="#waitlist">ลงทะเบียนรอ</a>
      </nav>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero" id="top">
        <div class="hero-copy">
          <p class="pill">✨ AI อ่านแชทให้ ตรง แต่หวังดี</p>
          <h1>
            ส่งแชทมา<br />แล้วป้าจะบอกว่า<br /><span class="mark"
              >เกิดอะไรขึ้นจริง ๆ</span
            >
          </h1>
          <p class="lead">
            ป้าเม้าท์อ่านแชท LINE / WhatsApp ของคุณตั้งแต่ข้อความแรก
            แล้วเล่าให้ฟังว่าใครใส่ใจใคร ช่วงไหนที่อะไรเปลี่ยนไป
            และบทบาทที่คุณเล่นอยู่ในสายตาคนอื่น — <b>ไม่เข้าข้างใคร ไม่ประจบ</b>
          </p>
          <div class="cta-row">
            <a class="btn" href="#waitlist">ลงทะเบียนรอทดลองฟรี</a>
            <a class="btn btn-ghost" href="#sample">ดูตัวอย่างรายงาน</a>
          </div>
          <ul class="ticks">
            <li>อ่านช่วงแรกฟรี</li>
            <li>ไม่ต้องใส่บัตร</li>
            <li>ลบแชทได้เอง</li>
          </ul>
        </div>

        <div class="stage" aria-label="ตัวอย่างแชทสมมติและความเห็นของป้า">
          <div class="blob b1" aria-hidden="true"></div>
          <div class="blob b2" aria-hidden="true"></div>

          <div class="phone">
            <div class="phone-head">
              <span class="back" aria-hidden="true">‹</span>
              <span class="avatar" aria-hidden="true">บ</span>
              <span class="who"><b>บีม</b><small>ตัวอย่างแชทสมมติ</small></span>
            </div>
            <div class="chat-day">วันนี้</div>
            <ol class="bubbles">
              {
                chat.map((m, i) => (
                  <li
                    class={`bubble ${m.me ? "me" : "them"}`}
                    style={`--i:${i}`}
                  >
                    {m.text}
                  </li>
                ))
              }
            </ol>
            <p class="read">อ่านแล้ว 02:14</p>
          </div>

          <div class="sticker s1" aria-hidden="true">⏱ ตอบช้าเฉลี่ย 4 ชม.</div>
          <div class="sticker s2" aria-hidden="true">โอเค ≠ โอเค</div>

          <div class="mascot" set:html={mascot} />
          <aside class="verdict" style="--i:11">
            <p class="verdict-tag">🍵 ป้าเม้าท์ว่า</p>
            <p>
              ฟ้าถามเรื่องวันเสาร์ครั้งเดียว แต่ที่จริงถามว่า <mark
                >“ฉันสำคัญแค่ไหน”</mark
              >
              — และคำว่า “โอเค” ตอนท้ายไม่ใช่โอเค
            </p>
          </aside>
        </div>
      </section>

      <!-- MARQUEE -->
      <section class="marquee" aria-label="แชทที่ใช้ได้">
        <p class="marquee-title">แชทไหนก็ได้ ที่มีคนคุยกันตั้งแต่สองคนขึ้นไป</p>
        <div class="track-wrap">
          <ul class="track">
            {chatTypes.map(c => <li>{c}</li>)}
          </ul>
          <ul class="track" aria-hidden="true">
            {chatTypes.map(c => <li>{c}</li>)}
          </ul>
        </div>
      </section>

      <!-- HOW -->
      <section class="block" id="how">
        <p class="kicker">วิธีใช้</p>
        <h2>ง่ายนิดเดียว 4 ขั้นตอน</h2>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="reveal" style={`--d:${i * 70}ms`}>
                <span class="step-num" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="step-ico" aria-hidden="true">
                  {s.i}
                </span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))
          }
        </ol>
        <p class="note">
          รองรับ LINE และ WhatsApp ก่อน · Instagram / Messenger ตามมาในรุ่นถัดไป
        </p>
      </section>

      <!-- INCLUDES -->
      <section class="block tint" id="includes">
        <p class="kicker">ในรายงาน</p>
        <h2>ได้อะไรจากรายงานหนึ่งฉบับ</h2>
        <div class="bento">
          {
            includes.map((x, i) => (
              <article class={`bcard ${x.c} reveal`} style={`--d:${i * 60}ms`}>
                <h3>{x.h}</h3>
                <p>{x.p}</p>
              </article>
            ))
          }
          <figure
            class="sharecard reveal"
            aria-label="ตัวอย่างการ์ดแชร์ (สมมติ)"
          >
            <div class="share-mascot" set:html={mascot} aria-hidden="true" />
