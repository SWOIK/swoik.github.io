    <script is:inline>
      document.documentElement.classList.add("js");
      (function () {
        // reveal on scroll + sticky CTA (ไม่มี IntersectionObserver ก็แสดงเนื้อหาปกติ)
        var reveals = document.querySelectorAll(".reveal");
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add("in");
                  io.unobserve(en.target);
                }
              });
            },
            { threshold: 0.12 }
          );
          reveals.forEach(function (el) {
            io.observe(el);
          });
          var sticky = document.getElementById("sticky-cta");
          var hero = document.getElementById("top");
          var wl = document.getElementById("waitlist");
          var heroOut = false,
            wlIn = false;
          function upd() {
            if (sticky) sticky.classList.toggle("show", heroOut && !wlIn);
          }
          new IntersectionObserver(function (e) {
            heroOut = !e[0].isIntersecting;
            upd();
          }).observe(hero);
          new IntersectionObserver(function (e) {
            wlIn = e[0].isIntersecting;
            upd();
          }).observe(wl);
        } else {
          reveals.forEach(function (el) {
            el.classList.add("in");
          });
        }
      })();

      // Waitlist form (prototype).
      // WAITLIST_ENDPOINT ว่างไว้โดยตั้งใจ: ยังไม่มี backend จึงไม่บันทึก/ส่งข้อมูลใด ๆ
      // เมื่อมี endpoint จริง (เช่น ฟังก์ชัน serverless + ฐานข้อมูล) ให้ใส่ URL ที่นี่
      // และอัปเดตนโยบายความเป็นส่วนตัวให้ตรงกับการเก็บข้อมูลจริงก่อนเปิดใช้
      var WAITLIST_ENDPOINT = "";
      (function () {
        var form = document.getElementById("waitlist-form");
        var status = document.getElementById("wl-status");
        if (!form || !status) return;
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          status.className = "";
          var email = form.elements["email"].value.trim();
          var consent = form.elements["consent"].checked;
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            status.className = "err";
            status.textContent = "กรุณากรอกอีเมลให้ถูกต้อง";
            form.elements["email"].focus();
            return;
          }
          if (!consent) {
            status.className = "err";
            status.textContent = "กรุณาติ๊กยินยอมการติดต่อก่อนส่ง";
            return;
          }
          if (!WAITLIST_ENDPOINT) {
            status.textContent =
              "นี่คือหน้าต้นแบบ ยังไม่ได้เชื่อมต่อที่เก็บข้อมูล จึงยังไม่ได้บันทึกอีเมลของคุณ";
            return;
          }
          status.textContent = "กำลังส่ง…";
          fetch(WAITLIST_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email: email,
              app: form.elements["app"].value,
              consent: true,
            }),
          })
            .then(function (r) {
              if (!r.ok) throw new Error("bad status");
              status.textContent = "ลงทะเบียนเรียบร้อย ขอบคุณที่สนใจ";
              form.reset();
            })
            .catch(function () {
              status.className = "err";
              status.textContent = "ส่งไม่สำเร็จ ลองใหม่อีกครั้งภายหลัง";
            });
        });
      })();
    </script>
  </body>
</html>
