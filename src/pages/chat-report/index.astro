          --muted: #bcb0cf;
          --line: #35294a;
          --card: #211a30;
          --marker: #7c3aed66;
          --me: #14532d;
          --them: #2a2140;
          --c-peach: #3a2417;
          --c-lav: #2b2150;
          --c-mint: #14352a;
          --c-rose: #3b1a2a;
