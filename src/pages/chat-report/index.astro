---
// ต้นแบบ landing page (ภาษาไทย) สำหรับผลิตภัณฑ์ "รายงานแชทด้วย AI"
// ชื่อ "ป้าเม้าท์" เป็นชื่อชั่วคราว ต้องตรวจเครื่องหมายการค้า/โดเมนก่อนใช้จริง
// ราคาและข้อความนโยบายเป็นสมมติฐานจาก docs/chat-report-product/*
// หน้านี้ไม่ประมวลผลหรือเก็บข้อมูลผู้ใช้ใด ๆ (ดูสคริปต์ท้ายไฟล์)
const title = "ป้าเม้าท์ — ส่งแชทมา แล้วฟังว่าเกิดอะไรขึ้นจริง ๆ (ต้นแบบ)";
const description =
  "ต้นแบบแนวคิด: อัปโหลดแชท LINE / WhatsApp แล้วให้ AI อ่านทั้งแชทและเล่าให้ฟังตรง ๆ ว่าใครใส่ใจใคร บทบาทของคุณคืออะไร";
const chat = [
  { who: "ฟ้า", me: true, text: "เสาร์นี้ว่างป่าว" },
  { who: "บีม", me: false, text: "เดี๋ยวดูก่อนนะ" },
  { who: "ฟ้า", me: true, text: "จองร้านไว้แล้วนะ สองทุ่ม" },
  { who: "บีม", me: false, text: "โทษที เพิ่งเห็น งานยุ่งมาก 😅" },
  { who: "ฟ้า", me: true, text: "แต่โพสต์สตอรี่ตอนตีสองได้นะ" },
  { who: "บีม", me: false, text: "อันนั้นมันคนละเรื่องเลย" },
  { who: "ฟ้า", me: true, text: "ตกลงมาไหม" },
  { who: "บีม", me: false, text: "น่าจะมา 🙄" },
  { who: "ฟ้า", me: true, text: "โอเค" },
  { who: "บีม", me: false, text: "อย่าโอเคแบบนั้นดิ" },
];
const chatTypes = [
  "💞 แฟน / คนคุย",
  "👯 กลุ่มเพื่อน",
  "🏡 กลุ่มครอบครัว",
  "💼 กลุ่มที่ทำงาน",
  "💔 แชทกับแฟนเก่า",
  "🫶 เพื่อนสนิท",
  "👀 คนที่แอบชอบ",
  "🌀 สถานะคลุมเครือ",
];
const steps = [
  {
    t: "เลือกประเภทแชท",
    d: "แฟน เพื่อน ครอบครัว ที่ทำงาน — ป้าจะปรับโทนให้เข้ากับแชท",
  },
  {
    t: "ส่งไฟล์แชท",
    d: "LINE หรือ WhatsApp มีคู่มือบอกวิธีส่งออกแชททีละขั้น",
  },
  {
    t: "ยืนยันชื่อ",
    d: "บอกป้าว่าใครคือคุณ รวมชื่อที่ซ้ำกัน (ขั้นนี้ทำให้รายงานแม่นขึ้นมาก)",
  },
  {
    t: "อ่านรายงาน",
    d: "อ่านช่วงแรกฟรี ถ้าถูกใจค่อยปลดล็อกทั้งฉบับ แล้วแชร์เข้ากลุ่มได้",
  },
];
const includes = [
  {
    h: "เรื่องเล่าของทั้งแชท",
    p: "ไม่ใช่สรุปแห้ง ๆ แต่เล่าว่ามีช่วงไหนอบอุ่น ช่วงไหนห่าง จุดเปลี่ยนคือเมื่อไร",
  },
  {
    h: "ความเห็นรายคน",
    p: "ทุกคนในแชทถูกอ่านด้วยมาตรฐานเดียวกัน รวมถึงคุณ ป้าไม่เข้าข้างใคร",
  },
  {
    h: "ตัวเลขที่นับจริง",
    p: "ใครทักก่อน ตอบช้าแค่ไหน ใครพิมพ์เยอะกว่า — คำนวณด้วยโปรแกรม ไม่ใช่เดา",
  },
  {
    h: "บทบาทที่เล่น vs บทบาทที่คิดว่าเล่น",
    p: "สิ่งที่เพื่อนเกรงใจไม่กล้าบอก และคนใกล้ตัวมักมองไม่เห็น",
  },
  {
    h: "คำพูดจริงจากแชท",
    p: "ทุกประโยคที่ป้ายกมาเป็นข้อความที่มีอยู่จริงในแชท ตรวจก่อนแสดงผล",
  },
  {
    h: "ข้อเสนอที่ทำได้จริง",
    p: "ไม่ใช่คำคมสวย ๆ แต่เป็นสิ่งเล็ก ๆ ที่ลองทำได้ภายในสัปดาห์นี้",
  },
];
const privacy = [
  {
    h: "ลบแชทอัตโนมัติ",
    p: "เป้าหมายนโยบาย: ลบไฟล์แชทภายใน 7 วันหลังรายงานล่าสุด และภายใน 48 ชั่วโมงถ้าไม่ได้ซื้อ",
  },
  {
    h: "ไม่เอาแชทไปเทรนโมเดล",
    p: "ใช้ผู้ให้บริการ AI ที่ตกลงเงื่อนไขไม่นำข้อมูลไปเทรน และบอกชื่อผู้ให้บริการในนโยบาย",
  },
  {
    h: "ไม่มีใครในทีมอ่านแชทคุณ",
    p: "รายงานสร้างโดย AI การเข้าถึงข้อมูลของทีมถูกจำกัดและมีบันทึก",
  },
  {
    h: "ลบเองได้ทุกเมื่อ",
    p: "ลบแชท ลบรายงาน หรือลบบัญชีทั้งหมดเองได้จากหน้าบัญชี",
  },
];
const tiers = [
  {
    n: "แชทสั้น",
    s: "ไม่เกิน ~2,000 ข้อความ",
    p: "฿79",
    note: "เช่น คนคุยใหม่ ๆ หรือกลุ่มที่เพิ่งตั้ง",
  },
  {
    n: "แชททั่วไป",
    s: "~2,000–8,000 ข้อความ",
    p: "฿129",
    note: "ขนาดที่เจอบ่อยที่สุดสำหรับแชทคู่",
    featured: true,
  },
  {
    n: "แชทยาว",
    s: "~8,000–25,000 ข้อความ",
    p: "฿199",
    note: "ป้าอ่านข้อความล่าสุดเป็นหลักและบอกช่วงที่อ่านชัดเจน",
  },
];
const faqs = [
  {
    q: "ฟรีจริงไหม?",
    a: "ช่วงแรกของรายงานอ่านได้ฟรี ไม่ต้องใส่บัตร ถ้าอยากอ่านต่อค่อยปลดล็อกตามราคาที่เห็นก่อนจ่ายเสมอ (ราคาในหน้านี้เป็นราคาทดลอง)",
  },
  {
    q: "ต่างจากแปะแชทใน ChatGPT ยังไง?",
    a: "แชทจริงมักยาวเกินกว่าที่แชตบอททั่วไปรับได้ในครั้งเดียว และคำตอบมักเอาใจผู้ถาม ป้าถูกออกแบบให้ไม่เข้าข้างใคร ให้ผลเป็นรายงานที่แชร์ได้ และต่อยอดเป็นการสืบเรื่องหลายรอบได้",
  },
  {
    q: "คนในแชทจะรู้ไหมว่าเราอัปโหลด?",
    a: "การส่งออกแชทไม่แจ้งเตือนใคร และป้าไม่ติดต่อใครในแชท แต่ถ้าแชร์ลิงก์รายงานให้คนอื่น เขาก็อ่านได้ — แชร์เมื่อพร้อมเท่านั้น",
  },
  {
    q: "แม่นแค่ไหน?",
    a: 'แม่นเท่าที่แชทบอก ป้าอ่านเฉพาะข้อความ ไม่รู้เรื่องที่คุยทางโทรศัพท์หรือเจอกันจริง และไม่ฟังเสียง ไม่ดูรูป อ่านเป็น "ความเห็นตรง ๆ จากคนนอก" ไม่ใช่ความจริง และไม่ใช่คำแนะนำทางการแพทย์ กฎหมาย หรือจิตวิทยา',
  },
  {
    q: "ถ้าแชทมีเรื่องหนัก ๆ เช่น ทำร้ายตัวเอง?",
    a: "ป้าจะไม่เล่นมุก บอกตรง ๆ ว่ามีสัญญาณที่น่าห่วง และชี้ไปยังความช่วยเหลือจริง เช่น สายด่วนสุขภาพจิต 1323 (ตรวจสอบหมายเลขล่าสุดก่อนใช้งานจริง)",
  },
  {
    q: "รองรับแอปอะไร?",
    a: "เป้าหมายเริ่มต้นคือ LINE และ WhatsApp จากนั้น Instagram และ Messenger ส่วน Telegram, Discord ฯลฯ ขอโหวตความต้องการจากผู้ลงทะเบียนรอ",
  },
];
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main">ข้ามไปเนื้อหาหลัก</a>

    <div class="banner" role="note">
      <strong>ต้นแบบ (Prototype)</strong> — หน้านี้ทดสอบแนวคิดเท่านั้น ยังไม่เปิดให้บริการ
      ไม่มีการอัปโหลดแชท และไม่เก็บข้อมูลใด ๆ รายงานและแชทในหน้านี้เป็นตัวอย่างสมมติ
    </div>

    <header class="top">
      <a class="brand" href="#top" aria-label="ป้าเม้าท์ กลับขึ้นบนสุด">
        <span class="brand-mark" aria-hidden="true">🍵</span>
        <span>ป้าเม้าท์</span>
      </a>
      <nav aria-label="เมนูหลัก">
        <a href="#how">วิธีใช้</a>
        <a href="#privacy">ความเป็นส่วนตัว</a>
        <a href="#pricing">ราคา</a>
        <a href="#faq">คำถามที่พบบ่อย</a>
        <a class="btn btn-small" href="#waitlist">ลงทะเบียนรอ</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="hero-copy">
          <p class="eyebrow">AI อ่านแชทให้ ตรง แต่หวังดี</p>
          <h1>
            ส่งแชทมา<br />แล้วป้าจะบอกว่า<br /><em>เกิดอะไรขึ้นจริง ๆ</em>
          </h1>
          <p class="lead">
            ป้าเม้าท์อ่านแชท LINE / WhatsApp ของคุณตั้งแต่ข้อความแรก
            แล้วเล่าให้ฟังว่าใครใส่ใจใคร ช่วงไหนที่อะไรเปลี่ยนไป
            และบทบาทที่คุณเล่นอยู่ในสายตาคนอื่น
            <strong>โดยไม่เข้าข้างใคร ไม่ประจบ</strong>
          </p>
          <div class="cta-row">
            <a class="btn" href="#waitlist">ลงทะเบียนรอทดลองฟรี</a>
            <a class="btn btn-ghost" href="#sample">ดูตัวอย่างรายงาน</a>
          </div>
          <p class="fine">
            อ่านช่วงแรกของรายงานฟรี · ไม่ต้องใส่บัตร · ลบแชทของคุณได้เอง
          </p>
        </div>

        <div class="hero-demo" aria-label="ตัวอย่างแชทสมมติ">
          <div class="phone">
            <div class="phone-head">
              <span class="dot" aria-hidden="true"></span> ฟ้า & บีม
              <small>ตัวอย่างสมมติ</small>
            </div>
            <ol class="bubbles">
              {
                chat.map((m, i) => (
                  <li
                    class={`bubble ${m.me ? "me" : "them"}`}
                    style={`--i:${i}`}
                  >
                    <span class="who">{m.who}</span>
                    {m.text}
                  </li>
                ))
              }
            </ol>
          </div>
          <aside class="verdict" style="--i:11">
            <p class="verdict-tag">🍵 ป้าเม้าท์ว่า</p>
            <p>
              ฟ้าถามเรื่องวันเสาร์ครั้งเดียว แต่ที่จริงถามว่า "ฉันสำคัญแค่ไหน" —
              และคำว่า "โอเค" ตอนท้ายไม่ใช่โอเค
            </p>
          </aside>
        </div>
      </section>

      <section class="strip" aria-label="แชทที่ใช้ได้">
        <p>ใช้กับแชทแบบไหนก็ได้ที่มีคนคุยกันตั้งแต่สองคน</p>
        <ul class="chips">
          {chatTypes.map(c => <li>{c}</li>)}
        </ul>
      </section>

      <section class="block" id="how">
        <h2>ใช้ง่าย ใน 4 ขั้นตอน</h2>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="num" aria-hidden="true">
                  {i + 1}
                </span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))
          }
        </ol>
        <p class="note">
          รองรับ LINE และ WhatsApp ก่อน · Instagram / Messenger ตามมาในรุ่นถัดไป
        </p>
      </section>

      <section class="block alt" id="includes">
        <h2>ในรายงานมีอะไรบ้าง</h2>
        <div class="grid">
          {
            includes.map(x => (
              <article class="card">
                <h3>{x.h}</h3>
                <p>{x.p}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="block" id="sample">
        <h2>หน้าตารายงาน (ตัวอย่างสมมติ)</h2>
        <p class="sub">
          ข้อความและตัวเลขด้านล่างเขียนขึ้นเพื่อแสดงรูปแบบ ไม่ได้มาจากแชทจริง
        </p>
        <div class="report" role="group" aria-label="ตัวอย่างรายงาน">
          <header class="report-head">
            <div>
              <p class="eyebrow">รายงานฉบับที่ 1</p>
              <h3>ฟ้า & บีม · 1,842 ข้อความ</h3>
            </div>
            <span class="badge">อ่านฟรี ~25%</span>
          </header>
          <div class="report-body">
            <h4>ภาพรวม</h4>
            <p>
              แชทนี้เริ่มต้นด้วยพลังงานสูงทั้งสองฝ่าย แล้วค่อย ๆ
              เปลี่ยนเป็นรูปแบบเดิมซ้ำ ๆ: ฟ้าเป็นฝ่ายเสนอ บีมเป็นฝ่ายตอบรับ (ช้า
              ๆ) ตั้งแต่เดือนที่สามเป็นต้นมา
            </p>
            <h4>ความเห็นรายคน</h4>
            <p>
              <strong>ฟ้า</strong> — ถามตรงแต่ทดสอบอ้อม ๆ (ถามคำถามเดียวกันสามรอบในรูปแบบต่างกัน)
              ความกังวลของฟ้าไม่ได้อยู่ที่วันเสาร์ แต่อยู่ที่การไม่ได้ลำดับความสำคัญ
            </p>
            <p class="locked-line">
              <strong>บีม</strong> — ตอบรับเสมอแต่ไม่ผูกมัด ใช้คำว่า "น่าจะ"
              <span class="blur" aria-hidden="true">
                มากกว่าคำตอบที่ชัดเจน ซึ่งทำให้ฟ้าต้องเดาอยู่ตลอด
                และนี่คือแพตเทิร์นที่เกิดขึ้นซ้ำในช่วงที่ผ่านมา…
              </span>
            </p>
            <div class="lock" role="note">
              <p>
                🔒 ส่วนที่เหลือ: บทบาทที่เล่น · จุดเปลี่ยน · ข้อเสนอที่ลองทำได้
              </p>
              <a class="btn btn-small" href="#waitlist"
                >ขอทดลองใช้กับแชทของตัวเอง</a
              >
            </div>
          </div>
        </div>
      </section>

      <section class="block alt" id="privacy">
        <h2>ข้อมูลแชทเป็นเรื่องส่วนตัวมาก เราจึงออกแบบจากตรงนี้ก่อน</h2>
        <div class="grid">
          {
            privacy.map(x => (
              <article class="card">
                <h3>{x.h}</h3>
                <p>{x.p}</p>
              </article>
            ))
          }
        </div>
        <p class="note">
          ข้อความเหล่านี้คือ <strong>เป้าหมายนโยบาย</strong> ของผลิตภัณฑ์ ก่อนเปิดให้บริการจริงต้องมีนโยบายความเป็นส่วนตัวตามกฎหมาย
          PDPA ที่ผ่านการตรวจโดยผู้เชี่ยวชาญ
        </p>
      </section>

      <section class="block" id="pricing">
        <h2>ราคา (ราคาทดลอง — ยังไม่ใช่ราคาจริง)</h2>
        <p class="sub">
          จ่ายต่อรายงาน ไม่มีสมัครสมาชิกอัตโนมัติ เห็นราคาก่อนจ่ายเสมอ ชำระผ่าน
          PromptPay หรือบัตร
        </p>
        <div class="tiers">
          {
            tiers.map(t => (
              <article class={`tier${t.featured ? " featured" : ""}`}>
                {t.featured && <span class="badge">พบบ่อยที่สุด</span>}
                <h3>{t.n}</h3>
                <p class="size">{t.s}</p>
                <p class="price">
                  {t.p}
                  <small> / รายงาน</small>
                </p>
                <p class="tier-note">{t.note}</p>
              </article>
            ))
          }
        </div>
        <ul class="extras">
          <li>
            <strong>รายงานต่อเนื่อง ฿59–79</strong> — เพิ่มบริบทหรือข้อความใหม่ แล้วให้ป้าอ่านต่อ
          </li>
          <li>
            <strong>รายงานรวมหลายแชท ฿399–599</strong> — อ่านสองถึงห้าแชทพร้อมกัน
            เพื่อดูภาพรวมของคุณ
          </li>
          <li>
            <strong>คุยกับป้าผ่าน LINE (สมาชิกรายเดือน ~฿299)</strong> — กำลังพิจารณา
          </li>
        </ul>
        <p class="note">
          ราคาทั้งหมดรวมภาษีแล้ว และจะทดสอบ/ปรับก่อนเปิดจริง
          รายงานที่สร้างไม่สำเร็จคืนเงินเต็มจำนวนอัตโนมัติ
        </p>
      </section>

      <section class="block alt" id="faq">
        <h2>คำถามที่พบบ่อย</h2>
